# /etc/sudoers.d/ops-team — политика доступа команды операции (СТАРТЕР)
#
# Это ТА САМАЯ политика, что действует сейчас на shadow-server-01. Её писали
# в спешке, в первый день, когда важнее было «чтобы работало».
#
# Правь этот файл в artifacts/, потом проверяй:  bash tests/test.sh
#
# Правила чтения sudoers — обратные sshd_config:
#   - побеждает ПОСЛЕДНЕЕ совпавшее правило, а не первое;
#   - правило совпадает по четвёрке «кто, где, от кого, какая команда»;
#   - широкое правило выше не отменяется узким ниже: если широкое
#     совпадает с запрошенной командой и стоит позже — победит оно;
#   - команда без абсолютного пути не совпадёт никогда.
#
# Что должно получиться (подробности — в mission.md):
#   каждый из команды может ровно то, что ему нужно по роли, и ничего сверх;
#   root-доступ есть у одного названного человека, с паролем и с записью
#   сессии; учётные записи, которых нет в команде, не получают ничего.

Defaults        !authenticate
Defaults        env_keep += "LD_PRELOAD LD_LIBRARY_PATH"

%sudo   ALL=(ALL:ALL) ALL

max     ALL=(ALL) NOPASSWD: ALL
viktor  ALL=(ALL) ALL
alex    ALL=(ALL) NOPASSWD: /usr/bin/vim, /usr/sbin/ip, /usr/bin/ss
anna    ALL=(ALL) NOPASSWD: /usr/bin/less, /usr/bin/journalctl
dmitry  ALL=(ALL) NOPASSWD: /usr/bin/systemctl
