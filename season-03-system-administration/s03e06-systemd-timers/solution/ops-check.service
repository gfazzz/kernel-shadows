# /etc/systemd/system/ops-check.service — ЭТАЛОН
#
# Службу, которую запускает таймер, включать НЕ надо: включается таймер.
# Отсюда отсутствие секции [Install] — это не забывчивость, а решение.

[Unit]
Description=Разовая проверка состояния серверов операции
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/ops-check.sh
TimeoutStartSec=120

User=ops-monitor
Group=ops-monitor

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
StateDirectory=ops-monitor

MemoryMax=256M
TasksMax=32
SyslogIdentifier=ops-check

# ---------------------------------------------------------------------------
# ПОЧЕМУ ИМЕННО ТАК
#
# Type=oneshot вместо simple.
#   simple означает «служба запущена, как только процесс создан», и systemd
#   сразу считает её активной. oneshot ждёт завершения процесса и только
#   потом считает запуск успешным — именно это нужно разовой задаче.
#   Побочный полезный эффект: `systemctl status` показывает результат
#   последнего запуска, а не «active (running)» у процесса, которого нет.
#
# Restart убран совсем.
#   Для Type=oneshot systemd запрещает Restart=always и откажется загружать
#   юнит. Логика простая: перезапускать задачу, которая по замыслу
#   завершается, — это цикл. Повторные запуски здесь обеспечивает таймер.
#
# TimeoutStartSec=120.
#   Разовая задача без таймаута может повиснуть навсегда — например, на
#   недоступном сервере. Пока она висит, следующий запуск таймера не
#   произойдёт: два экземпляра одной службы одновременно не работают.
#   Таймаут превращает зависание в честную ошибку в журнале.
#
# Нет секции [Install].
#   Иначе `systemctl enable ops-check` включит и службу тоже, и она
#   запустится один раз при загрузке — независимо от таймера. Формально
#   не ошибка, но означает, что расписание описано в двух местах.
#
# Ограничения — те же, что в s03e05.
#   Разовость задачи не делает её безопаснее: она выполняет тот же код.
