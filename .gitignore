# Python bytecode (не коммитим — см. ep22 cleanup, v2.0)
__pycache__/
*.pyc
*.pyo

# Student solutions (keep only template)
# OLD: игнорировали всё кроме .sh
# NEW: разрешаем Type B конфиги (YAML, Dockerfile, configs, etc.)
**/solution/*
!**/solution/.gitkeep
!**/solution/*.sh.example

# Exception: Season project solution (reference implementation)
!season-1-shell-foundations/season-project/solution/
!season-1-shell-foundations/season-project/solution/*.sh

