# /etc/fstab — таблица монтирования shadow-server-01 (ЭТАЛОН)
#
# Проверять ДО перезагрузки:
#   findmnt --verify --verbose
#   mount -a && findmnt
#
# Устройство  точка  тип  опции  dump  pass
#
# ━━━ корень ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
UUID=e4c8a17b-52d9-4f36-b0a1-7e93c65d284f  /          ext4  defaults,noatime                    0  1

# ━━━ загрузчик ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
UUID=9d21f4c7-3b8e-4a15-9f02-6c7d1e4a8b33  /boot      ext4  defaults,noatime,nodev,nosuid,noexec  0  2

# ━━━ данные служб ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
UUID=7a3f9d15-c862-4e07-91b4-2d5f8a06c3e9  /var       ext4  defaults,noatime,nodev,nosuid         0  2

# ━━━ журналы ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 520 ГБ после расширения из s03e09. Здесь не должно исполняться
# ничего и не должно быть ни устройств, ни SUID-файлов.
UUID=1b6e5c40-9af3-4d28-83c7-5e10b742f9a6  /var/log   ext4  defaults,noatime,nodev,nosuid,noexec  0  2

# ━━━ очереди ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
UUID=c92d1873-4b60-45ea-a3f8-8c274e0b95d1  /var/spool ext4  defaults,noatime,nodev,nosuid,noexec  0  2

# ━━━ подкачка ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
UUID=3f80b2ae-671c-4d95-8e23-a05f9c1d7648  none       swap  sw                                    0  0

# ---------------------------------------------------------------------------
# ПОЧЕМУ ИМЕННО ТАК
#
# UUID вместо имён устройств.
#   /dev/vdb — это порядок обнаружения дисков при ЭТОЙ загрузке. Добавили
#   диск, поменяли порт, мигрировали на другой гипервизор — порядок другой,
#   и /var/log монтируется из чужого тома. UUID генерируется при создании
#   файловой системы и не меняется. Сверить: blkid.
#   Имена /dev/mapper/имя--группы-том тоже устойчивы (их создаёт LVM, а не
#   порядок обнаружения) — но UUID работает одинаково и там, и там.
#
# Строка для /dev/vdb1 (/backup) убрана.
#   Такого устройства в blkid нет. Запись в fstab для несуществующего
#   устройства без опции nofail останавливает загрузку и переводит машину
#   в аварийный режим с запросом пароля root. Это самая частая причина
#   «сервер не поднялся после перезагрузки».
#
# /var/log добавлен и указан по UUID тома, а не диска.
#   В стартере он монтировался с /dev/vdb — то есть с физического носителя,
#   который на самом деле является PV и своей файловой системы не имеет.
#
# nodev,nosuid,noexec на /var/log, /var/spool и /boot.
#   Прямое продолжение s03e02 и s03e04: SUID-копия оболочки в каталоге,
#   смонтированном с nosuid, не даёт прав; программа в каталоге с noexec
#   не запускается. Это не защита от root, а сужение возможностей для того,
#   кто root ещё не получил.
#   На /var эти опции ограничены двумя: там лежат данные служб, и noexec
#   ломает часть пакетов.
#
# noatime.
#   По умолчанию ядро обновляет время последнего доступа при каждом чтении —
#   то есть пишет на диск при чтении. На томе с журналами это заметная
#   лишняя нагрузка и ничего взамен.
#
# pass: 1 у корня, 2 у остальных, 0 у swap.
#   Порядок проверки fsck при загрузке. Корень проверяется первым и
#   отдельно; тома с одинаковым номером проверяются параллельно.
#   Нулём помечают то, что проверять не нужно, — swap и tmpfs.
#
# dump всегда 0.
#   Поле осталось от утилиты dump, которой давно никто не пользуется.
