# Dockerfile для ops/collector (ЭТАЛОН)
#
# Собрать и посмотреть, что получилось:
#   docker build -t ops/collector:1.5.0 .
#   docker history ops/collector:1.5.0
#   docker inspect ops/collector:1.5.0 --format '{{.Config.User}} {{.Config.Env}}'

FROM python:3.11.6-slim

# ── системные пакеты: меняются раз в полгода, значит выше ──────────────
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# ── непривилегированный пользователь ──────────────────────────────────
RUN useradd --system --create-home --uid 10001 collector

WORKDIR /app

# ── зависимости: меняются раз в неделю ────────────────────────────────
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# ── код: меняется каждый раз, поэтому ниже всего ──────────────────────
COPY --chown=collector:collector . /app

USER collector

HEALTHCHECK --interval=30s --timeout=3s CMD ["python", "/app/healthcheck.py"]

CMD ["python", "/app/collector.py"]

# ---------------------------------------------------------------------------
# ПОЧЕМУ ИМЕННО ТАК
#
# FROM python:3.11.6-slim, а не python:3.11 и не :latest.
#   Точная версия — чтобы сборка через месяц дала то же самое. Облегчённая
#   база — чтобы внутрь не приехали компиляторы и всё, что к ним прилагается:
#   по сканеру это 9 уязвимостей против 61 и 130 МБ против гигабайта.
#
# Порядок инструкций — единственное, что определяет время сборки.
#   Кеш ломается на первом изменившемся слое и обесценивает всё, что ниже.
#   Код меняется каждый раз, зависимости — раз в неделю, системные пакеты —
#   раз в полгода. Значит, порядок обратный частоте: пакеты, зависимости, код.
#   В стартере `COPY . /app` стоит перед pip — и pip выполняется при каждой
#   правке одной строки.
#
# apt-get update, install и rm -rf в ОДНОЙ инструкции.
#   Отдельной инструкцией `rm -rf /var/lib/apt/lists/*` не даст ничего: кеш
#   apt останется в предыдущем слое (см. s04e04). --no-install-recommends
#   убирает десятки пакетов, которые никто не просил.
#
# Ни одного ENV с секретом.
#   Переменные из ENV печатает `docker inspect` у любого, кто получил образ,
#   и они же лежат в истории слоёв. Пароль передают при ЗАПУСКЕ: --env-file,
#   секреты оркестратора, а на время сборки — RUN --mount=type=secret.
#
# Ни одного COPY ключа.
#   Ключ, попавший в слой, из образа не удаляется — это и разбирали вчера.
#   Здесь его нет вовсе, а от случайного попадания вместе с `COPY . /app`
#   защищает .dockerignore.
#
# USER collector после установки, но до CMD.
#   Инструкции установки требуют root, поэтому пользователь переключается
#   в конце. Числовой UID задан явно: оркестраторы умеют требовать
#   «не root», и им нужен номер, а не имя.
#   COPY --chown избавляет от отдельного RUN chown — то есть от лишнего слоя
#   размером со всё приложение.
#
# CMD в exec-форме (массив JSON), а не строкой.
#   Строка запускается через /bin/sh -c, и процесс приложения получает
#   PID 2, а PID 1 достаётся оболочке. Она не пересылает сигналы — и
#   `docker stop` вместо остановки ждёт таймаут и убивает контейнер.
#   Тот же вопрос, что TERM против KILL в s03e04.
