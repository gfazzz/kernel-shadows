# sshd_config — рабочая конфигурация серверов операции (СТАРТЕР)
#
# Это ТА САМАЯ конфигурация, что стоит сейчас на боевых машинах: сервер
# принимает пароли, пускает root напрямую и не ограничивает число попыток.
# Задача — закалить её, не потеряв доступ.
#
# Правь этот файл в artifacts/, потом проверяй:  bash tests/test.sh
#
# Правила чтения sshd_config:
#   - побеждает ПЕРВОЕ вхождение директивы, а не последнее;
#   - строка с # — комментарий, а не настройка (даже если в ней написано верное);
#   - регистр имени директивы значения не имеет, отступ допустим.
#
# Что должно получиться (подробности — в mission.md):
#   вход только по ключам, root напрямую не пускать, пустые пароли запрещены,
#   лишние возможности выключены, число попыток ограничено, доступ — по группе,
#   в журнал должно попадать, каким ключом вошли.

Port 22
Protocol 2

# --- Аутентификация --------------------------------------------------------
PermitRootLogin yes
PasswordAuthentication yes
#PermitEmptyPasswords no
KbdInteractiveAuthentication yes
PubkeyAuthentication yes
MaxAuthTries 6

# --- Что разрешено внутри сессии -------------------------------------------
X11Forwarding yes
AllowTcpForwarding yes

# --- Кто может входить -----------------------------------------------------
# (не задано — значит, все, у кого есть учётная запись)

# --- Журналирование --------------------------------------------------------
LogLevel INFO

# --- Прочее ----------------------------------------------------------------
UsePAM yes
Subsystem sftp /usr/lib/openssh/sftp-server
