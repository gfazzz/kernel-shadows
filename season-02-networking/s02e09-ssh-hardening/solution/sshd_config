# sshd_config — закалённая конфигурация серверов операции
# ЭТАЛОН, открывать после своей попытки.
#
# Порядок применения на живой машине:
#   sudo cp /etc/ssh/sshd_config /etc/ssh/sshd_config.bak
#   sudo sshd -t                  # проверка синтаксиса — обязательна
#   sudo systemctl reload ssh     # текущие сессии не рвутся
#   ssh -i ~/.ssh/id_ed25519 user@server   # из ДРУГОГО терминала, не закрыв этот
#
# Проверить, что сервер понял именно это:  sudo sshd -T | grep -i permitrootlogin

Port 22
Protocol 2

# --- Аутентификация --------------------------------------------------------
# root не входит напрямую: все действия — от именованного пользователя через sudo,
# иначе в журналах не остаётся, кто именно что сделал.
PermitRootLogin no

# Только ключи. После этого перебор паролей теряет смысл: метод не предлагается.
PasswordAuthentication no

# Обходной путь к паролям через PAM — закрыть вместе с предыдущим,
# иначе PasswordAuthentication no отключает не всё.
KbdInteractiveAuthentication no

PermitEmptyPasswords no
PubkeyAuthentication yes

# Меньше попыток в одном соединении — меньше пользы от перебора ключей.
MaxAuthTries 3

# --- Что разрешено внутри сессии -------------------------------------------
X11Forwarding no
AllowTcpForwarding no

# --- Кто может входить -----------------------------------------------------
# Явный список сильнее неявного «все, у кого есть учётка».
AllowGroups ssh-users

# --- Журналирование --------------------------------------------------------
# VERBOSE добавляет в журнал отпечаток ключа, которым выполнен вход.
# Без него при разборе инцидента известно только имя пользователя.
LogLevel VERBOSE

# --- Сессии ----------------------------------------------------------------
ClientAliveInterval 300
ClientAliveCountMax 2

# --- Прочее ----------------------------------------------------------------
UsePAM yes
Subsystem sftp /usr/lib/openssh/sftp-server
