# /etc/fstab узла shadow-node-07 — корень только для чтения (ЭТАЛОН, s06e04).
#
# Узел стоит на улице, питание ему рубят без предупреждения, а пишет он на
# SD-карту. Две беды сразу: внезапное отключение при записи бьёт файловую
# систему, а сама запись изнашивает ячейки. Лечение одно — не писать.
#
# Поля: устройство  точка_монтирования  тип  опции  dump  pass

# ── Носитель: смонтирован только для чтения ─────────────────────────
# Раздел загрузки после настройки не меняется вообще.
PARTUUID=6c586e13-01  /boot  vfat  ro,nosuid,nodev,noatime  0  2

# Корень: ro. Ни один сбой питания не застанет его в середине записи,
# и ни одна ячейка под ним не изнашивается.
PARTUUID=6c586e13-02  /      ext4  ro,noatime               0  1

# ── Что пишется и должно исчезать при старте (tmpfs) ────────────────
# Память вместо карты. Размеры — из замеров в data/write_paths.txt,
# с запасом; суммарно меньше половины ОЗУ, иначе узел уйдёт в своп
# (которого у него нет) и словит OOM.
tmpfs  /tmp       tmpfs  rw,nosuid,nodev,noexec,size=192M,mode=1777  0  0
tmpfs  /var/log   tmpfs  rw,nosuid,nodev,noexec,size=512M,mode=0755  0  0
tmpfs  /var/tmp   tmpfs  rw,nosuid,nodev,noexec,size=32M,mode=1777   0  0

# ── Что должно быть видно и при этом записываемо (overlay) ──────────
# /etc нельзя очистить в tmpfs: система должна видеть исходные файлы.
# overlay кладёт поверх ro-каталога слой в памяти: чтение — из нижнего,
# запись — в верхний. При перезагрузке верхний слой исчезает.
overlay  /etc  overlay  rw,nosuid,nodev,lowerdir=/etc,upperdir=/run/overlay/etc/upper,workdir=/run/overlay/etc/work,x-systemd.requires-mounts-for=/run  0  0

# ── Что обязано пережить перезагрузку (отдельный раздел) ────────────
# Единственное место на карте, куда вообще идёт запись: 2 МБ в сутки
# вместо 475. nofail — чтобы узел поднялся даже с побитым разделом
# данных: иначе на удалённой площадке чинить будет некому и нечем.
PARTUUID=6c586e13-03  /var/lib/shadow-mesh  ext4  rw,noatime,nosuid,nodev,nofail  0  2
