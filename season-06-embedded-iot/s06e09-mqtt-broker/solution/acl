# acl — права по темам для брокера shadow_mesh (ЭТАЛОН, s06e09)
#
# ВАЖНО: строки topic, стоящие ДО первого user/pattern, относятся к
# анонимным клиентам. Здесь их нет ни одной — анонимных не бывает.
#
# Проверить после правки:  mosquitto_ctrl / перезапуск и mosquitto_sub
# от имени каждой роли.

# ── Устройства: правило общее, тема — своя ──────────────────────────
# %u подставляет имя пользователя. Узел shadow-node-07 получает право
# писать в shadow/shadow-node-07/telemetry/# и никуда больше: чужую
# телеметрию он не подделает, даже если его взломают.
pattern write shadow/%u/telemetry/#

# И читать команды, адресованные лично ему.
pattern read shadow/%u/cmd/#

# ── Панель: наоборот ────────────────────────────────────────────────
user dashboard
# читает телеметрию всех узлов…
topic read shadow/+/telemetry/#
# …и выдаёт команды. Писать в телеметрию она не может: тогда картинку
# можно было бы нарисовать, не спрашивая устройства.
topic write shadow/+/cmd/#

# ── Архиватор: только слушает ───────────────────────────────────────
user recorder
topic read shadow/+/telemetry/#

# ── Наблюдение за самим брокером ────────────────────────────────────
# $SYS не покрывается подпиской на # — это отдельная ветка, и доступ к
# ней выдаётся отдельно.
user monitor
topic read $SYS/#
