#!/usr/sbin/nft -f
#
# syn-defense.nft — набор правил на время атаки (СТАРТЕР)
#
# Проверить, не применяя:   nft -c -f syn-defense.nft
#
# Каркас задаёт форму таблицы. Правила пишешь сам, и порядок в них —
# часть решения: он определяет, что и сколько раз проверяется.
#
# Что обязано работать после применения — в data/services.txt.
# Откуда ходит дежурная смена — в data/mgmt_net.txt.
# Каким бывает обычный темп новых соединений — в data/conn_baseline.txt.
#
# И один урок из s08e01, который здесь придётся применить: адреса
# источников подделаны. Правило, перечисляющее их, бесполезно.

flush ruleset

table inet filter {

    # Счётчик обращений с каждого адреса. Подумай, что случится с
    # памятью, если у множества не будет ни времени жизни, ни предела
    # размера, а адресов — миллионы.
    set syn_flood_seen {
        type ipv4_addr
        flags dynamic, timeout
        # TODO: timeout и size
    }

    chain input {
        # TODO: тип, хук, приоритет и политика по умолчанию

        # TODO: правила. Порядок имеет значение — дешёвое и частое
        #       раньше дорогого и редкого; доступ дежурного выше
        #       ограничителя темпа.
    }

    chain forward {
        # TODO: этот узел ничего не пересылает
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}
