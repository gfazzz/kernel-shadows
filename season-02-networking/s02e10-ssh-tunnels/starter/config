# ~/.ssh/config — конфигурация клиента SSH (СТАРТЕР)
#
# То, что Дмитрий держал у себя. Работает: он ходит на все машины
# операции и не вводит пароль. Но каждая вторая строка здесь — либо
# лишний риск, либо мёртвая настройка.
#
# Правь этот файл в artifacts/, потом проверяй:  bash tests/test.sh
#
# Правило чтения ssh_config, из-за которого половина проблем:
#   для каждого параметра действует ПЕРВОЕ найденное значение,
#   а блоки просматриваются сверху вниз. Значит, блок `Host *`
#   должен стоять ПОСЛЕДНИМ — иначе он перекроет всё, что ниже.
#
# Что должно получиться (подробности — в mission.md):
#   проход к внутренним машинам через бастион, локальный порт к базе,
#   обратный туннель к своему сервису, SOCKS для браузера — и клиент,
#   который не отдаёт свой ключ чужому серверу.

Host *
    ForwardAgent yes
    StrictHostKeyChecking no
    User dmitry

Host bastion
    HostName bastion.ops.local

Host db
    HostName db.internal
    ProxyCommand ssh -W %h:%p bastion
    LocalForward 5432 db.internal:5432

Host moscow
    HostName 10.0.7.10
