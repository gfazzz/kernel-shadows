# /etc/systemd/system/ops-check.timer — ЭТАЛОН
#
# Установка:
#   sudo install -m 0644 ops-check.timer ops-check.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ops-check.timer      # ИМЕННО .timer, не .service
# Проверка:
#   systemctl list-timers ops-check.timer
#   systemd-analyze calendar '*:0/5'

[Unit]
Description=Проверка состояния серверов операции каждые пять минут
Documentation=man:systemd.timer(5)

[Timer]
OnCalendar=*:0/5
Persistent=true
RandomizedDelaySec=30
AccuracySec=1s
Unit=ops-check.service

[Install]
WantedBy=timers.target

# ---------------------------------------------------------------------------
# ПОЧЕМУ ИМЕННО ТАК
#
# OnCalendar=*:0/5 — это НЕ cron.
#   Формат systemd: «ДЕНЬ ГОД-МЕСЯЦ-ЧИСЛО ЧАС:МИНУТА:СЕКУНДА». Запись
#   `*:0/5` читается как «каждый час, минуты начиная с 0 с шагом 5».
#   Строка `*/5 * * * *` из crontab здесь недопустима: systemd разберёт её
#   как дату и откажется загружать юнит.
#   Проверять выражение до установки: `systemd-analyze calendar '*:0/5'`
#   — команда покажет ближайшие срабатывания.
#
# Persistent=true.
#   Если машина была выключена в момент срабатывания, таймер запустится
#   сразу после загрузки. У cron этого нет вовсе (за этим ставили anacron).
#   Для мониторинга это разница между «пропустили окно» и «увидели дыру
#   в данных с отметкой времени».
#
# RandomizedDelaySec=30.
#   Разброс запуска. На одном сервере не важен; на двадцати — избавляет от
#   всплеска нагрузки ровно в :00, :05, :10, когда все машины стартуют
#   одновременно и упираются в один и тот же сетевой сервис.
#
# AccuracySec=1s.
#   По умолчанию systemd имеет право отложить запуск на минуту, чтобы
#   собрать таймеры в пачки и дать процессору поспать. Для пятиминутного
#   мониторинга минута — это 20 % интервала.
#
# Unit=ops-check.service.
#   Можно не писать: таймер по умолчанию запускает службу с тем же именем.
#   Написано явно, потому что молчаливая связь по имени файла — первое,
#   что ломается при переименовании.
#
# WantedBy=timers.target, а не multi-user.target.
#   Таймеры собираются в своей цели. С multi-user.target юнит формально
#   включится, но в `systemctl list-timers` не появится.
