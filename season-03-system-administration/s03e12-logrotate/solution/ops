# /etc/logrotate.d/ops — ротация журналов операции (ЭТАЛОН)
#
# Проверка без последствий:
#   logrotate -d /etc/logrotate.d/ops        # разбор и план, ничего не делается
#   logrotate -f /etc/logrotate.d/ops        # принудительный поворот (осторожно)
#   systemctl status logrotate.timer         # чем запускается

/var/log/ops/*.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    dateext
    create 0640 syslog adm
    sharedscripts
    postrotate
        /usr/lib/rsyslog/rsyslog-rotate
    endscript
}

/var/log/nginx/*.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    dateext
    create 0640 www-data adm
    sharedscripts
    postrotate
        [ -f /run/nginx.pid ] && kill -USR1 "$(cat /run/nginx.pid)"
    endscript
}

# ---------------------------------------------------------------------------
# ПОЧЕМУ ИМЕННО ТАК
#
# postrotate — та строка, которой не было 14 октября.
#   logrotate переименовывает файл и создаёт новый. Процесс, который держит
#   старый открытым, об этом не знает: у него дескриптор, а не имя, и он
#   продолжает писать в переименованный (а потом и в удалённый) файл.
#   Для rsyslog штатный способ сказать «перечитай дескрипторы» —
#   /usr/lib/rsyslog/rsyslog-rotate (внутри это kill -HUP), для nginx —
#   сигнал USR1. Без этого получается ровно то, что нашлось в s03e08:
#   десять гигабайт, видимых в df и невидимых в du.
#
# sharedscripts.
#   Путь содержит шаблон *.log, то есть блок относится к нескольким файлам.
#   Без sharedscripts postrotate выполняется ПОСЛЕ КАЖДОГО — то есть служба
#   получает сигнал столько раз, сколько журналов. С ним — один раз, после
#   поворота всех.
#
# delaycompress.
#   Сжатие откладывается на один цикл: свежеповёрнутый .1 остаётся несжатым.
#   Это нужно именно тем службам, которые узнают о повороте с задержкой:
#   пока процесс не перечитал дескрипторы, он ещё пишет в .1, и сжимать
#   его рано.
#
# rotate 14 вместо 3.
#   Три дня — меньше, чем время обнаружения инцидента. Ровно этого не хватило
#   при разборе 17 октября: события 14-го уже почти ушли. Две недели — минимум,
#   при котором понедельничный разбор пятничного происшествия ещё возможен.
#
# create 0640 syslog adm.
#   Новый файл создаётся сразу с нужными правами и владельцем. Без create он
#   унаследует их от... ничего: файла не будет вовсе до первой записи, и
#   создаст его служба со своим umask. Права 0640 — те же, что у /etc/shadow:
#   читают владелец и группа adm, в которой из s03e01 состоят max и anna.
#
# missingok, notifempty.
#   Отсутствующий журнал — не ошибка (служба могла не запускаться), пустой
#   поворачивать незачем. Без них logrotate шлёт письмо об ошибке при каждом
#   запуске, и на него перестают смотреть.
#
# dateext.
#   Суффикс -2025-10-14 вместо .1, .2, .3. Разница практическая: при обычной
#   схеме файлы переименовываются на каждом цикле, и «ops.log.3» вчера и
#   сегодня — разные дни. С dateext имя означает дату и не меняется.
#
# copytruncate здесь НЕ используется.
#   Он копирует файл и обнуляет оригинал, не трогая дескриптор, — и потому
#   не требует сигнала. Цена: строки, записанные между копированием и
#   обнулением, теряются молча. Годится для программ, которые не умеют
#   перечитывать дескрипторы; rsyslog и nginx умеют.
