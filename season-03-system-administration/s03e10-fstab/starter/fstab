# /etc/fstab — таблица монтирования shadow-server-01 (СТАРТЕР)
#
# Этот файл машина читает при загрузке. Ошибка в нём не «работает
# неправильно» — она означает, что сервер не поднимется и будет ждать
# пароль root в аварийном режиме. Проверять до перезагрузки:
#   findmnt --verify --verbose
#   mount -a          (смонтирует всё, что ещё не смонтировано)
#
# Правь этот файл в artifacts/, потом проверяй:  bash tests/test.sh
#
# Формат — шесть полей через пробелы:
#   устройство  точка_монтирования  тип  опции  dump  pass
#
#   dump  — реликт, всегда 0
#   pass  — порядок проверки fsck при загрузке:
#           1 у корня, 2 у остальных с файловой системой, 0 у прочих
#
# Что должно получиться (подробности — в mission.md):
#   все тома смонтированы, устройства заданы устойчиво, /var/log
#   с ограничивающими опциями, ни одной записи для устройства,
#   которого больше нет.

/dev/mapper/ops--vg-root  /            ext4  defaults        0  1
/dev/vda1                 /boot        ext4  defaults        0  2
/dev/mapper/ops--vg-var   /var         ext4  defaults        0  2
/dev/vdb                  /var/log     ext4  defaults        0  2
/dev/vdb1                 /backup      ext4  defaults        0  2
/dev/mapper/ops--vg-swap  none         swap  sw              0  0
