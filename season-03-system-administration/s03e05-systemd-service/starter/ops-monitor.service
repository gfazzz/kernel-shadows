# /etc/systemd/system/ops-monitor.service — черновик Дмитрия (СТАРТЕР)
#
# Написан быстро, «чтобы наконец запустилось». Работает — и это вся его
# заслуга. Задача — довести до состояния, которое не стыдно оставить
# на сервере после инцидента.
#
# Правь этот файл в artifacts/, потом проверяй:  bash tests/test.sh
#
# Правила чтения unit-файлов systemd:
#   - файл состоит из секций [Unit], [Service], [Install];
#   - для большинства настроек побеждает ПОСЛЕДНЕЕ присваивание;
#   - пустое значение (Key= без ничего) СБРАСЫВАЕТ настройку, а не задаёт «пусто»;
#   - строка с # — комментарий; systemd не выполняет оболочку, поэтому
#     конвейеры и «;» в ExecStart работают не так, как ожидается.
#
# Что должно получиться (подробности — в mission.md):
#   служба стартует после появления сети, перезапускается при падении,
#   работает не от root, ограничена в правах и ресурсах, пишет в журнал
#   и включается в автозагрузку.

[Unit]
Description=monitor
After=network.target

[Service]
ExecStart=/usr/local/bin/ops-monitor.sh | logger -t ops-monitor
Restart=always
