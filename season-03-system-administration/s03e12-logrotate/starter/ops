# /etc/logrotate.d/ops — ротация журналов операции (СТАРТЕР)
#
# Это тот самый файл, из-за которого 14 октября десять гигабайт остались
# занятыми без единого имени: журнал повернули, старый файл удалили,
# а rsyslogd об этом никто не предупредил — и он продолжил писать
# в файл, которого больше нет (см. s03e08).
#
# Правь этот файл в artifacts/, потом проверяй:  bash tests/test.sh
#
# Формат: путь (можно с шаблоном), затем блок директив в фигурных скобках.
# Проверить на своей машине, ничего не поворачивая:
#   logrotate -d /etc/logrotate.d/ops
#
# Что должно получиться (подробности — в mission.md):
#   журналы обеих служб поворачиваются, хранятся достаточно долго,
#   сжимаются, создаются с правильными правами — и служба, которая
#   в них пишет, узнаёт о повороте.

/var/log/ops/*.log {
    daily
    rotate 3
    compress
}
