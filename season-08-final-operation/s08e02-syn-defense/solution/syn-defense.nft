#!/usr/sbin/nft -f
#
# syn-defense.nft — набор правил на время атаки (ЭТАЛОН)
#
# Проверить, не применяя:   nft -c -f syn-defense.nft
# Применить:                nft -f syn-defense.nft
#
# Порядок правил здесь — не оформление, а смысл. Дешёвые и частые
# решения стоят первыми, дорогие и редкие — последними.

flush ruleset

table inet filter {

    # Счётчик новых соединений с каждого адреса. Живёт 60 секунд после
    # последнего обращения, размер ограничен — иначе под атакой с
    # подделанных адресов сам счётчик станет утечкой памяти.
    set syn_flood_seen {
        type ipv4_addr
        flags dynamic, timeout
        timeout 60s
        size 65535
    }

    chain input {
        # Политика по умолчанию — запрет. Всё, что не разрешено явно,
        # отбрасывается (то же default-deny, что в s02e06 и s05e11).
        type filter hook input priority filter; policy drop;

        # 1. Уже установленные соединения — первыми и без проверок.
        #    Иначе каждый пакет длинной сессии проходил бы через
        #    ограничитель темпа и считался бы за новое соединение.
        ct state established,related accept

        # 2. Мусор отбрасывается сразу: пакеты, которых не может быть
        #    в валидном соединении, дальше не идут и ресурсов не тратят.
        ct state invalid drop

        # 3. Петля. Без этой строки узел ломает сам себя: локальные
        #    службы перестают ходить друг к другу.
        iif lo accept

        # 4. Диагностика ICMP с ограничением темпа — чтобы узел
        #    оставался виден для traceroute и MTU discovery.
        ip protocol icmp icmp type { echo-request, destination-unreachable, time-exceeded } limit rate 20/second accept

        # 5. Управляющая сеть: дежурный и сбор метрик. Стоит выше
        #    ограничителя намеренно — потерять доступ к узлу во время
        #    атаки хуже, чем пропустить лишний пакет.
        ip saddr 10.42.0.0/24 tcp dport { 22, 9100 } accept

        # 6. Ограничитель темпа новых соединений — на источник, а не
        #    общий. Общий предел под распределённой атакой закрывает
        #    вход всем сразу, то есть делает работу нападающего.
        #
        #    12 в секунду при 99-м перцентиле 6 и наибольшем виденном 23:
        #    вдвое выше обычного поведения клиента. Всплеск в 20 пакетов
        #    разрешён — браузер открывает несколько соединений разом.
        tcp flags syn / syn,ack \
            add @syn_flood_seen { ip saddr limit rate over 12/second burst 20 packets } \
            drop

        # 7. То, ради чего узел существует.
        tcp dport { 80, 443 } accept
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}
