# ~/.ssh/config — конфигурация клиента SSH (ЭТАЛОН)
#
# Проверить, что ssh видит именно то, что вы написали:
#   ssh -G db          # эффективные значения ВСЕХ параметров для хоста db
#   ssh -G db | grep -E 'proxyjump|forwardagent|localforward'
#
# Порядок блоков значим: действует ПЕРВОЕ найденное значение,
# поэтому `Host *` стоит последним.

# ━━━ бастион: единственная машина, видимая снаружи ━━━━━━━━━━━━━━━
Host bastion
    HostName bastion.ops.local
    User max
    Port 22
    IdentityFile ~/.ssh/id_ed25519_ops
    ForwardAgent no

# ━━━ база операции: только изнутри, через бастион ━━━━━━━━━━━━━━━━
Host db
    HostName db.internal
    User max
    ProxyJump bastion
    IdentityFile ~/.ssh/id_ed25519_ops
    LocalForward 15432 127.0.0.1:5432
    ForwardAgent no

# ━━━ московский узел: SOCKS для браузера ━━━━━━━━━━━━━━━━━━━━━━━━━
Host moscow
    HostName 10.0.7.10
    User max
    ProxyJump bastion
    IdentityFile ~/.ssh/id_ed25519_ops
    DynamicForward 127.0.0.1:1080
    ForwardAgent no

# ━━━ отладочный узел: наш локальный сервис отдаётся туда ━━━━━━━━━
Host devbox
    HostName devbox.ops.local
    User max
    ProxyJump bastion
    IdentityFile ~/.ssh/id_ed25519_ops
    RemoteForward 127.0.0.1:9000 127.0.0.1:3000
    ForwardAgent no

# ━━━ общее для всех — ПОСЛЕДНИМ ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
Host *
    ForwardAgent no
    IdentitiesOnly yes
    StrictHostKeyChecking ask
    HashKnownHosts yes
    ServerAliveInterval 30
    ServerAliveCountMax 3
    AddKeysToAgent yes
    Compression no

# ---------------------------------------------------------------------------
# ПОЧЕМУ ИМЕННО ТАК
#
# `Host *` стоит последним.
#   ssh берёт ПЕРВОЕ найденное значение параметра, просматривая файл сверху
#   вниз. Блок `Host *` совпадает с любым хостом, поэтому наверху он
#   перекрывает всё, что написано ниже: `User dmitry` в нём означает, что
#   вы всегда ходите как dmitry, сколько бы `User max` ни стояло дальше.
#   Проверяется без всяких догадок: `ssh -G db | grep '^user '`.
#
# ProxyJump вместо ProxyCommand.
#   `ProxyCommand ssh -W %h:%p bastion` делает то же самое, но появился
#   раньше и требует помнить синтаксис. `ProxyJump bastion` — одна строка,
#   и она умеет цепочки: `ProxyJump bastion,relay`.
#
# ForwardAgent no — везде.
#   Проброс агента означает: у бастиона появляется доступ к вашему ключу
#   на время сессии. Тот, кто получил root на бастионе, ходит вашим ключом
#   куда угодно, и в журналах это вы. ProxyJump закрывает ту же задачу
#   (добраться до внутренней машины), не отдавая ключ никому: соединение
#   шифруется от вашей машины до конечной, бастион только пересылает байты.
#
# LocalForward 15432 127.0.0.1:5432 на хосте db.
#   «Слушать 15432 у себя, отдавать в 5432 на той стороне». Адрес
#   127.0.0.1 в правой части — с точки зрения СЕРВЕРА: база слушает
#   локально и снаружи не видна. Локальный порт 15432, а не 5432, чтобы
#   не конфликтовать со своей базой.
#
# RemoteForward 127.0.0.1:9000 127.0.0.1:3000.
#   Обратное направление: порт 9000 НА СЕРВЕРЕ отдаёт наш локальный 3000.
#   Явный `127.0.0.1:` в левой части обязателен: без него порт может
#   оказаться на всех интерфейсах сервера (если там `GatewayPorts yes`),
#   и ваш отладочный сервис станет доступен из интернета.
#
# DynamicForward 127.0.0.1:1080.
#   SOCKS5-прокси: браузер отправляет туда весь трафик, тот уходит через
#   moscow. Тоже привязан к 127.0.0.1 — иначе прокси открыт всей сети,
#   и через вашу машину ходит кто угодно.
#
# IdentitiesOnly yes.
#   Без него агент предлагает серверу ВСЕ известные ключи по очереди.
#   На сервере с `MaxAuthTries 3` (см. s02e09) третий ключ обрывает
#   соединение, и вход не проходит вовсе — при совершенно правильном ключе.
#
# StrictHostKeyChecking ask, HashKnownHosts yes.
#   `no` отключает единственную защиту от подмены сервера — ту самую
#   атаку, что разбиралась в s02e05, только для SSH. Хеширование
#   known_hosts не даёт прочитать по нему список ваших машин.
#
# ServerAliveInterval 30.
#   Туннель за NAT молча умирает через несколько минут простоя. Клиент
#   раз в 30 секунд напоминает о себе; после трёх неответов рвёт сам,
#   и это лучше, чем «висит, но не работает».
