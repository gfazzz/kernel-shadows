# .env.example — какие переменные нужны, без значений
#
# Копируется в .env, который в репозиторий не попадает:
#   cp .env.example .env && $EDITOR .env
#
# Смысл файла: человек, склонировавший репозиторий, должен узнать состав
# переменных, не спрашивая никого и не получая при этом ни одного секрета.

DB_HOST=
DB_USER=
DB_PASSWORD=
API_TOKEN=
