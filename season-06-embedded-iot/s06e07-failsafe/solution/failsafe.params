# failsafe.params — отказоустойчивость shadow-uav-03 (ЭТАЛОН, s06e07)
#
# Формат ArduPilot: ИМЯ,ЗНАЧЕНИЕ — по параметру на строку.
# Единицы у каждого параметра свои (см. data/param_reference.txt);
# ошибка в единицах не даёт ошибки при загрузке, она даёт аварию.

# ── Потеря управления с пульта ──────────────────────────────────────
# 1 = вернуться домой. Ноль здесь означает «продолжать, что делал»,
# то есть улететь по последней команде в никуда.
FS_THR_ENABLE,1
# Порог ниже минимума канала газа (1098 по калибровке): при потере
# сигнала приёмник отдаёт значение вне рабочего диапазона, а внутри
# диапазона порог срабатывал бы при обычном сбросе газа.
FS_THR_VALUE,975

# ── Потеря связи с наземной станцией ────────────────────────────────
# Именно этот отказ вернул аппарат в разборе s06e05. Выключать нельзя.
FS_GCS_ENABLE,1

# ── Развал оценки положения ─────────────────────────────────────────
# 1 = сесть на месте. Возвращаться домой, не зная, где ты, — хуже.
FS_EKF_ACTION,1
FS_EKF_THRESH,0.8

# ── Батарея: два порога, мягкий раньше жёсткого ─────────────────────
# 4 банки Li-ion, минимум 3.30 В на банку -> 13.2 В абсолютный низ.
# Низкий заряд объявляем с запасом на возврат.
BATT_LOW_VOLT,14.00
# Критический — ниже низкого, иначе мягкая реакция не наступит никогда.
BATT_CRT_VOLT,13.40
# Низкий -> возврат домой (2). Критический -> посадка на месте (1):
# лететь уже не на чем.
BATT_FS_LOW_ACT,2
BATT_FS_CRT_ACT,1

# ── Геозона ─────────────────────────────────────────────────────────
FENCE_ENABLE,1
# Битовая маска: 1 потолок + 2 радиус = 3. Только радиус (2) оставляет
# аппарату право уйти вверх, только потолок (1) — уйти за горизонт.
FENCE_TYPE,3
# Больше самой дальней точки утверждённого маршрута (780 м) с запасом
# на ветер и погрешность: иначе штатный полёт сам вызывает срабатывание.
FENCE_RADIUS,1500
# Не выше регламента площадки (120 м) и не ниже высоты возврата,
# иначе возврат сам нарушает геозону.
FENCE_ALT_MAX,110
# 1 = вернуться домой.
FENCE_ACTION,1

# ── Возврат домой ───────────────────────────────────────────────────
# В САНТИМЕТРАХ. 6000 = 60 м: выше вышки связи (45 м) с запасом
# и ниже потолка геозоны (110 м).
RTL_ALT,6000
# 0 = садиться, а не зависать над домом. Зависание тратит остаток
# заряда там, где уже можно сесть.
RTL_ALT_FINAL,0
# Скорость снижения, см/с.
LAND_SPEED,50
